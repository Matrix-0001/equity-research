# Copy to .env (git-ignored) and fill in. Never commit the real .env.

# Sharadar data via Nasdaq Data Link. Get this from your account at
# https://data.nasdaq.com/ (Account Settings -> API Key) after subscribing to
# the Sharadar SF1 (fundamentals) + SEP (prices) databases on the
# non-professional / personal license.
NASDAQ_DATA_LINK_API_KEY=

# Where local data lives (parquet snapshots + DuckDB). Defaults to ./data
# EQR_DATA_DIR=./data
